/*
 * Corne 3x5+3 keymap, ported from Callum Oakley's QMK userspace:
 * https://github.com/qmk/qmk_firmware/tree/user-keymaps-still-present/users/callum
 *
 * Differences from Callum:
 *   - QWERTY base layer (Callum uses Colemak).
 *   - 3 thumb keys per side: Callum's two go on the middle + inner thumbs; the outer thumbs are blank.
 *   - One-shot mods are ZMK sticky keys (&sk). They time out after release-after-ms instead of being
 *     cancelled by tapping NAV/SYM.
 *   - Added a SYS layer (hold Z+X) for Bluetooth, USB/BT output, bootloader and reset on each half.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEF 0
#define SYM 1
#define NAV 2
#define NUM 3
#define SYS 4

// macOS shortcuts (Callum's defines; HOME/END renamed so they don't clobber ZMK's HOME/END keycodes)
#define M_HOME &kp LG(LEFT)
#define M_END  &kp LG(RIGHT)
#define FWD   &kp LG(RBKT)
#define BACK  &kp LG(LBKT)
#define TABL  &kp LG(LS(LBKT))
#define TABR  &kp LG(LS(RBKT))
#define SPCL  &kp LA(LG(LEFT))
#define SPC_R &kp LA(LG(RIGHT))

// One-shot modifiers
#define OS_SHFT &sk LSHIFT
#define OS_CTRL &sk LCTRL
#define OS_ALT  &sk LALT
#define OS_CMD  &sk LGUI

#define XXX &none
#define ___ &trans

// An unused one-shot modifier is dropped after this long (Callum's version has no timeout,
// but cancels on a NAV/SYM tap, which ZMK sticky keys can't do).
&sk {
        release-after-ms = <2000>;
};

/ {
        chosen {
                zmk,physical-layout = &foostan_corne_5col_layout;
        };

        behaviors {
                // Swappers (Callum's swapper.c), from the zmk-tri-state module.
                // First press: hold modifier + tap key. Further presses: tap key.
                // Any other key or layer change (e.g. releasing NAV) releases the modifier.
                sw_win: swapper_win {
                        compatible = "zmk,behavior-tri-state";
                        #binding-cells = <0>;
                        bindings = <&kt LGUI>, <&kp TAB>, <&kt LGUI>;
                };
                sw_lang: swapper_lang {
                        compatible = "zmk,behavior-tri-state";
                        #binding-cells = <0>;
                        bindings = <&kt LCTRL>, <&kp SPACE>, <&kt LCTRL>;
                };
        };

        // Holding SYM + NAV activates NUM (Callum's tri-layer)
        conditional_layers {
                compatible = "zmk,conditional-layers";
                tri_layer {
                        if-layers = <SYM NAV>;
                        then-layer = <NUM>;
                };
        };

        combos {
                compatible = "zmk,combos";
                // Hold Z + X together for the SYS layer
                combo_sys {
                        key-positions = <20 21>;
                        bindings = <&mo SYS>;
                        timeout-ms = <50>;
                        require-prior-idle-ms = <150>;
                        layers = <DEF>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                def_layer {
                        display-name = "DEF";
// ┌─────┬─────┬─────┬─────┬─────┐   ┌─────┬─────┬─────┬─────┬─────┐
// │  Q  │  W  │  E  │  R  │  T  │   │  Y  │  U  │  I  │  O  │  P  │
// │  A  │  S  │  D  │  F  │  G  │   │  H  │  J  │  K  │  L  │  '  │
// │  Z  │  X  │  C  │  V  │  B  │   │  N  │  M  │  ,  │  .  │  /  │
// └─────┴─────┴─────┼─────┼─────┤   ├─────┼─────┼─────┴─────┴─────┘
//             │     │ NAV │SHIFT│   │SPACE│ SYM │     │
                        bindings = <
   &kp Q  &kp W  &kp E  &kp R     &kp T         &kp Y      &kp U    &kp I      &kp O    &kp P
   &kp A  &kp S  &kp D  &kp F     &kp G         &kp H      &kp J    &kp K      &kp L    &kp SQT
   &kp Z  &kp X  &kp C  &kp V     &kp B         &kp N      &kp M    &kp COMMA  &kp DOT  &kp FSLH
                 XXX    &mo NAV   &kp LSHIFT    &kp SPACE  &mo SYM  XXX
                        >;
                };

                sym_layer {
                        display-name = "SYM";
// ┌─────┬─────┬─────┬─────┬─────┐   ┌─────┬─────┬─────┬─────┬─────┐
// │ ESC │  [  │  {  │  (  │  ~  │   │  ^  │  )  │  }  │  ]  │  `  │
// │  -  │  *  │  =  │  _  │  $  │   │  #  │ CMD │ ALT │CTRL │SHIFT│  ← one-shot
// │  +  │  |  │  @  │  \  │  %  │   │     │  &  │  ;  │  :  │  !  │
// └─────┴─────┴─────┼─────┼─────┤   ├─────┼─────┼─────┴─────┴─────┘
//             │     │     │     │   │     │ ▓▓▓ │     │
                        bindings = <
   &kp ESC   &kp LBKT  &kp LBRC  &kp LPAR   &kp TILDE    &kp CARET  &kp RPAR  &kp RBRC  &kp RBKT   &kp GRAVE
   &kp MINUS &kp ASTRK &kp EQUAL &kp UNDER  &kp DLLR     &kp HASH   OS_CMD    OS_ALT    OS_CTRL    OS_SHFT
   &kp PLUS  &kp PIPE  &kp AT    &kp BSLH   &kp PRCNT    XXX        &kp AMPS  &kp SEMI  &kp COLON  &kp EXCL
                       ___       ___        ___          ___        ___       ___
                        >;
                };

                nav_layer {
                        display-name = "NAV";
// ┌─────┬─────┬─────┬─────┬─────┐   ┌─────┬─────┬─────┬─────┬─────┐
// │ TAB │SWWIN│TAB← │TAB→ │VOL+ │   │BOOT │HOME │  ↑  │ END │ DEL │
// │SHIFT│CTRL │ ALT │ CMD │VOL- │   │CAPS │  ←  │  ↓  │  →  │BSPC │  ← one-shot
// │SPC← │SPC→ │BACK │ FWD │PLAY │   │     │PGDN │PGUP │SWLNG│ ENT │
// └─────┴─────┴─────┼─────┼─────┤   ├─────┼─────┼─────┴─────┴─────┘
//             │     │ ▓▓▓ │     │   │     │     │     │
                        bindings = <
   &kp TAB  &sw_win  TABL     TABR     &kp C_VOL_UP   &bootloader  M_HOME    &kp UP    M_END     &kp DEL
   OS_SHFT  OS_CTRL  OS_ALT   OS_CMD   &kp C_VOL_DN   &kp CAPS     &kp LEFT  &kp DOWN  &kp RIGHT &kp BSPC
   SPCL     SPC_R    BACK     FWD      &kp C_PP       XXX          &kp PG_DN &kp PG_UP &sw_lang  &kp RET
                     ___      ___      ___            ___          ___       ___
                        >;
                };

                num_layer {
                        display-name = "NUM";
// ┌─────┬─────┬─────┬─────┬─────┐   ┌─────┬─────┬─────┬─────┬─────┐
// │  7  │  5  │  3  │  1  │  9  │   │  8  │  0  │  2  │  4  │  6  │
// │SHIFT│CTRL │ ALT │ CMD │ F11 │   │ F10 │ CMD │ ALT │CTRL │SHIFT│  ← one-shot
// │ F7  │ F5  │ F3  │ F1  │ F9  │   │ F8  │ F12 │ F2  │ F4  │ F6  │
// └─────┴─────┴─────┼─────┼─────┤   ├─────┼─────┼─────┴─────┴─────┘
//             │     │ ▓▓▓ │     │   │     │ ▓▓▓ │     │
                        bindings = <
   &kp N7   &kp N5   &kp N3   &kp N1   &kp N9    &kp N8   &kp N0   &kp N2   &kp N4   &kp N6
   OS_SHFT  OS_CTRL  OS_ALT   OS_CMD   &kp F11   &kp F10  OS_CMD   OS_ALT   OS_CTRL  OS_SHFT
   &kp F7   &kp F5   &kp F3   &kp F1   &kp F9    &kp F8   &kp F12  &kp F2   &kp F4   &kp F6
                     ___      ___      ___       ___      ___      ___
                        >;
                };

                sys_layer {
                        display-name = "SYS";
// Hold Z + X. BOOT = bootloader (flashing mode) and RST = restart, each on the half it's pressed on.
// ┌─────┬─────┬─────┬─────┬─────┐   ┌─────┬─────┬─────┬─────┬─────┐
// │     │     │     │     │BOOT │   │ BT1 │ BT2 │ BT3 │ BT4 │ BT5 │
// │     │     │     │     │ RST │   │BTCLR│     │     │     │USB/BT
// │ ▓▓▓ │ ▓▓▓ │     │     │     │   │BOOT │ RST │     │     │     │
// └─────┴─────┴─────┼─────┼─────┤   ├─────┼─────┼─────┴─────┴─────┘
//             │     │     │     │   │     │     │     │
                        bindings = <
   XXX  XXX  XXX  XXX  &bootloader    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
   XXX  XXX  XXX  XXX  &sys_reset     &bt BT_CLR    XXX           XXX           XXX           &out OUT_TOG
   ___  ___  XXX  XXX  XXX            &bootloader   &sys_reset    XXX           XXX           XXX
             XXX  XXX  XXX            XXX           XXX           XXX
                        >;
                };
        };
};
